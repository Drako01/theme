    "breadcrumb.foreground": "#526576",
    "commandCenter.background": "#DDE3E0",
    "commandCenter.foreground": "#202C37",
    "commandCenter.border": "#C5D1DC",
    "chat.requestBorder": "#C5D1DC",
    "chat.slashCommandBackground": "#DDE3E0",
    "inlineChat.background": "#E6EAE6",
    "widget.border": "#C5D1DC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#536576",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6B39A4"
      }
    },
    {
      "name": "Strings and YAML values",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#186B3A"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#A14A27"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#005F99"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#8A5200"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#202C37"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#005F99"
      }
    },
    {
      "name": "Markup and tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#8A5200"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#835700"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#005F99"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9F1D2C",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "markup.deleted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#196739"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8A5200",
    "type": "#8A5200",
    "class": "#8A5200",
    "enum": "#8A5200",
    "interface": "#8A5200",
    "struct": "#8A5200",
    "typeParameter": "#8A5200",
    "parameter": "#202C37",
    "variable": "#202C37",
    "property": "#005F99",
    "enumMember": "#A14A27",
    "event": "#005F99",
    "function": "#005F99",
    "method": "#005F99",
    "macro": "#6B39A4",
    "keyword": "#6B39A4",
    "modifier": "#6B39A4",
    "comment": "#536576",
    "string": "#186B3A",
    "number": "#A14A27",
    "regexp": "#835700",
    "operator": "#6B39A4",
    "decorator": "#8A5200",
    "*.declaration": {
      "foreground": "#005F99"
    },
    "*.readonly": {
      "foreground": "#A14A27"
    }
  }
}
