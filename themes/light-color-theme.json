  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3A4C5E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5A2D8F"
      }
    },
    {
      "name": "Strings and YAML values",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#0F5A2E"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#7F3518"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#004E80"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#6F3F00"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#141B22"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#004E80"
      }
    },
    {
      "name": "Markup and tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6F3F00"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6F4700"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#004E80"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8A1624",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "markup.deleted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#14582F"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6F3F00",
    "type": "#6F3F00",
    "class": "#6F3F00",
    "enum": "#6F3F00",
    "interface": "#6F3F00",
    "struct": "#6F3F00",
    "typeParameter": "#6F3F00",
    "parameter": "#141B22",
    "variable": "#141B22",
    "property": "#004E80",
    "enumMember": "#7F3518",
    "event": "#004E80",
    "function": "#004E80",
    "method": "#004E80",
    "macro": "#5A2D8F",
    "keyword": "#5A2D8F",
    "modifier": "#5A2D8F",
    "comment": "#3A4C5E",
    "string": "#0F5A2E",
    "number": "#7F3518",
    "regexp": "#6F4700",
    "operator": "#5A2D8F",
    "decorator": "#6F3F00",
    "*.declaration": {
      "foreground": "#004E80"
    },
    "*.readonly": {
      "foreground": "#7F3518"
    }
  }
}
