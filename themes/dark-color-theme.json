    "commandCenter.foreground": "#E5E7EB",
    "commandCenter.border": "#354655",
    "chat.requestBorder": "#354655",
    "chat.slashCommandBackground": "#202C37",
    "inlineChat.background": "#19242E",
    "widget.border": "#354655"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#97AEBE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D8B8FF"
      }
    },
    {
      "name": "Strings and YAML values",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A4DFB1"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFBD9A"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8BD6FF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E5E7EB"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8BD6FF"
      }
    },
    {
      "name": "Markup and tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FFD67A"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#8BD6FF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF9A9E",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "markup.deleted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#A4DFB1"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#FFC66D",
    "type": "#FFC66D",
    "class": "#FFC66D",
    "enum": "#FFC66D",
    "interface": "#FFC66D",
    "struct": "#FFC66D",
    "typeParameter": "#FFC66D",
    "parameter": "#E5E7EB",
    "variable": "#E5E7EB",
    "property": "#8BD6FF",
    "enumMember": "#FFBD9A",
    "event": "#8BD6FF",
    "function": "#8BD6FF",
    "method": "#8BD6FF",
    "macro": "#D8B8FF",
    "keyword": "#D8B8FF",
    "modifier": "#D8B8FF",
    "comment": "#97AEBE",
    "string": "#A4DFB1",
    "number": "#FFBD9A",
    "regexp": "#FFD67A",
    "operator": "#D8B8FF",
    "decorator": "#FFC66D",
    "*.declaration": {
      "foreground": "#8BD6FF"
    },
    "*.readonly": {
      "foreground": "#FFBD9A"
    }
  }
}
