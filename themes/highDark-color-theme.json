    "chat.slashCommandBackground": "#111111",
    "inlineChat.background": "#090909",
    "widget.border": "#FFFFFF",
    "contrastBorder": "#FFFFFF",
    "contrastActiveBorder": "#F9ED32"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#D6D6D6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F5D0FF"
      }
    },
    {
      "name": "Strings and YAML values",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#B7FFCE"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFDCAC"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#B2E6FF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#FFE1AB"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B2E6FF"
      }
    },
    {
      "name": "Markup and tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FFE1AB"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FFE69A"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#B2E6FF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FFB8B8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "markup.deleted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#B7FFCE"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#FFE1AB",
    "type": "#FFE1AB",
    "class": "#FFE1AB",
    "enum": "#FFE1AB",
    "interface": "#FFE1AB",
    "struct": "#FFE1AB",
    "typeParameter": "#FFE1AB",
    "parameter": "#FFFFFF",
    "variable": "#FFFFFF",
    "property": "#B2E6FF",
    "enumMember": "#FFDCAC",
    "event": "#B2E6FF",
    "function": "#B2E6FF",
    "method": "#B2E6FF",
    "macro": "#F5D0FF",
    "keyword": "#F5D0FF",
    "modifier": "#F5D0FF",
    "comment": "#D6D6D6",
    "string": "#B7FFCE",
    "number": "#FFDCAC",
    "regexp": "#FFE69A",
    "operator": "#F5D0FF",
    "decorator": "#FFE1AB",
    "*.declaration": {
      "foreground": "#B2E6FF"
    },
    "*.readonly": {
      "foreground": "#FFDCAC"
    }
  }
}
