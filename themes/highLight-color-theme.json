    "contrastBorder": "#000000",
    "contrastActiveBorder": "#5B4C00"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#52127E"
      }
    },
    {
      "name": "Strings and YAML values",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#115528"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#753318"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#004D77"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#6C3B00"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Object keys and properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#004D77"
      }
    },
    {
      "name": "Markup and tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6C3B00"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6B4600"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#004D77"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8C1620",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "markup.deleted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#14552C"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6C3B00",
    "type": "#6C3B00",
    "class": "#6C3B00",
    "enum": "#6C3B00",
    "interface": "#6C3B00",
    "struct": "#6C3B00",
    "typeParameter": "#6C3B00",
    "parameter": "#000000",
    "variable": "#000000",
    "property": "#004D77",
    "enumMember": "#753318",
    "event": "#004D77",
    "function": "#004D77",
    "method": "#004D77",
    "macro": "#52127E",
    "keyword": "#52127E",
    "modifier": "#52127E",
    "comment": "#333333",
    "string": "#115528",
    "number": "#753318",
    "regexp": "#6B4600",
    "operator": "#52127E",
    "decorator": "#6C3B00",
    "*.declaration": {
      "foreground": "#004D77"
    },
    "*.readonly": {
      "foreground": "#753318"
    }
  }
}
